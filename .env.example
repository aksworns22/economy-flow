# GitHub Pages의 HTTPS JSON 주소. 비워두면 내장 샘플을 표시합니다.
VITE_CONTENT_URL=https://aksworns22.github.io/economy-flow/today.json
# 앱인토스 콘솔 등록 정보와 일치해야 합니다.
AIT_APP_NAME=today-economy-flow
# 스마트 발송 캠페인의 발송 코드. 빈 값으로 설정하면 신청 영역을 숨깁니다.
VITE_NOTIFICATION_TEMPLATE_CODE=today-economy-flow-economy-briefing-tuesday-10am
# SDK 3.x의 표시 이름 ‘오늘의 경제’와 아이콘은 콘솔에서 설정합니다.
